{
  "$schema": "./recipes.schema.json",
  "recipes": [
  {
    "id": "astro",
    "displayName": "Astro",
    "projectType": "generic",
    "configArguments": ["--project-type=generic", "--webserver-type=nginx-fpm", "--omit-containers=db", "--docroot=dist"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Create Astro project", "arguments": ["npm", "create", "astro@latest", "ddev-astro", "--", "--template=basics", "--no-install", "--yes", "--skip-houston", "--no-git"], "moveContents": ["ddev-astro"]},
      {"title": "Configure Astro", "writeFiles": [
        {"path": "astro.config.mjs", "resource": "/cms/templates/astro.config.mjs"},
        {"path": ".ddev/config.astro.yaml", "resource": "/cms/templates/config.astro.yaml"}
      ]},
      {"title": "Install Astro dependencies", "arguments": ["npm", "install"]},
      {"title": "Build Astro", "arguments": ["npm", "run", "build"]},
      {"title": "Restart DDEV", "arguments": ["restart", "--skip-confirmation"]}
    ],
    "requiresCredentials": false,
    "launch": {"port": 4321}
  },
  {
    "id": "wordpress",
    "displayName": "WordPress",
    "projectType": "wordpress",
    "configArguments": ["--project-type=wordpress"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Download WordPress", "arguments": ["wp", "core", "download"]},
      {"title": "Install WordPress", "arguments": ["wp", "core", "install", "--url=${PRIMARY_URL}", "--title=${PROJECT_NAME}", "--admin_user=${USERNAME}", "--admin_password=${PASSWORD}", "--admin_email=${EMAIL}"], "sensitive": true},
      {"title": "Configure WordPress permalinks", "arguments": ["wp", "rewrite", "structure", "/%postname%/"]},
      {"title": "Configure one-time WordPress login", "writeFiles": [{"path": "wp-content/mu-plugins/ddev-intellij-login.php", "resource": "/cms/templates/wordpress-auto-login.php"}]}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true,
    "launch": {"path": "/", "query": "ddev_intellij_login=${USERNAME_URLENCODED}&ddev_intellij_token=${LOGIN_TOKEN_URLENCODED}"}
  },
  {
    "id": "laravel",
    "displayName": "Laravel",
    "projectType": "laravel",
    "configArguments": ["--project-type=laravel", "--docroot=public"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Laravel", "arguments": ["composer", "create-project", "laravel/laravel"]}
    ],
    "requiresCredentials": false,
    "automaticProjectType": true
  },
  {
    "id": "drupal9",
    "displayName": "Drupal 9",
    "projectType": "drupal9",
    "configArguments": ["--project-type=drupal9", "--docroot=web", "--php-version=8.1"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Drupal", "arguments": ["composer", "create-project", "drupal/recommended-project:^9"]},
      {"title": "Install Drush", "arguments": ["composer", "require", "drush/drush"]},
      {"title": "Configure Drupal", "arguments": ["./vendor/bin/drush", "site:install", "--account-name=${USERNAME}", "--account-pass=${PASSWORD}", "--site-name=${PROJECT_NAME}", "-y"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true
  },
  {
    "id": "drupal10",
    "displayName": "Drupal 10",
    "projectType": "drupal10",
    "configArguments": ["--project-type=drupal10", "--docroot=web"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Drupal", "arguments": ["composer", "create-project", "drupal/recommended-project:^10"]},
      {"title": "Install Drush", "arguments": ["composer", "require", "drush/drush"]},
      {"title": "Configure Drupal", "arguments": ["./vendor/bin/drush", "site:install", "--account-name=${USERNAME}", "--account-pass=${PASSWORD}", "--site-name=${PROJECT_NAME}", "-y"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true
  },
  {
    "id": "drupal11",
    "displayName": "Drupal 11",
    "projectType": "drupal11",
    "configArguments": ["--project-type=drupal11", "--docroot=web"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Drupal", "arguments": ["composer", "create-project", "drupal/recommended-project:^11"]},
      {"title": "Install Drush", "arguments": ["composer", "require", "drush/drush"]},
      {"title": "Configure Drupal", "arguments": ["./vendor/bin/drush", "site:install", "--account-name=${USERNAME}", "--account-pass=${PASSWORD}", "--site-name=${PROJECT_NAME}", "-y"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true
  },
  {
    "id": "drupal12",
    "displayName": "Drupal 12",
    "projectType": "drupal12",
    "configArguments": ["--project-type=drupal12", "--docroot=web"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Drupal", "arguments": ["composer", "create-project", "drupal/recommended-project"]},
      {"title": "Install Drush", "arguments": ["composer", "require", "drush/drush"]},
      {"title": "Configure Drupal", "arguments": ["./vendor/bin/drush", "site:install", "--account-name=${USERNAME}", "--account-pass=${PASSWORD}", "--site-name=${PROJECT_NAME}", "-y"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true
  },
  {
    "id": "drupalcms",
    "displayName": "Drupal CMS",
    "projectType": "drupal11",
    "configArguments": ["--project-type=drupal11", "--docroot=web"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Drupal CMS", "arguments": ["composer", "create-project", "drupal/cms"]},
      {"title": "Unpack Drupal recipes", "arguments": ["composer", "drupal:recipe-unpack"]}
    ],
    "requiresCredentials": false
  },
  {
    "id": "backdrop",
    "displayName": "Backdrop CMS",
    "projectType": "backdrop",
    "configArguments": ["--project-type=backdrop"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Bee CLI", "arguments": ["add-on", "get", "backdrop-ops/ddev-backdrop-bee"]},
      {"title": "Restart DDEV with Bee", "arguments": ["restart", "--skip-confirmation"]},
      {"title": "Download Backdrop", "arguments": ["bee", "download-core"]},
      {"title": "Install Backdrop", "arguments": ["bee", "si", "--username=${USERNAME}", "--password=${PASSWORD}", "--db-name=db", "--db-user=db", "--db-pass=db", "--db-host=db", "--auto"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true
  },
  {
    "id": "cakephp",
    "displayName": "CakePHP",
    "projectType": "cakephp",
    "configArguments": ["--project-type=cakephp", "--docroot=webroot"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install CakePHP", "arguments": ["composer", "create-project", "--prefer-dist", "--no-interaction", "cakephp/app:~5.0"]}
    ],
    "requiresCredentials": false,
    "automaticProjectType": true
  },
  {
    "id": "codeigniter",
    "displayName": "CodeIgniter",
    "projectType": "codeigniter",
    "configArguments": ["--project-type=codeigniter", "--docroot=public"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install CodeIgniter", "arguments": ["composer", "create-project", "codeigniter4/appstarter"]}
    ],
    "requiresCredentials": false,
    "automaticProjectType": true
  },
  {
    "id": "craftcms",
    "displayName": "Craft CMS",
    "projectType": "craftcms",
    "configArguments": ["--project-type=craftcms", "--docroot=web"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Craft CMS", "arguments": ["composer", "create-project", "--no-scripts", "craftcms/craft"]},
      {"title": "Configure Craft CMS", "arguments": ["php", "craft", "install", "--email=${EMAIL}", "--username=${USERNAME}", "--password=${PASSWORD}", "--site-name=${PROJECT_NAME}", "--language=en-US"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true,
    "launch": {"path": "/admin"}
  },
  {
    "id": "grav",
    "displayName": "Grav CMS",
    "projectType": "php",
    "configArguments": ["--project-type=php", "--omit-containers=db"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Grav", "arguments": ["composer", "create-project", "getgrav/grav"]},
      {"title": "Restart DDEV", "arguments": ["restart", "--skip-confirmation"]},
      {"title": "Install Grav Admin", "arguments": ["exec", "gpm", "install", "admin", "-y"]}
    ],
    "requiresCredentials": false
  },
  {
    "id": "kirby",
    "displayName": "Kirby CMS",
    "projectType": "php",
    "configArguments": ["--project-type=php", "--omit-containers=db", "--webserver-type=apache-fpm"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Kirby", "arguments": ["composer", "create-project", "getkirby/starterkit"]}
    ],
    "requiresCredentials": false
  },
  {
    "id": "magento2",
    "displayName": "Magento 2",
    "projectType": "magento2",
    "configArguments": ["--project-type=magento2", "--docroot=pub", "--upload-dirs=media", "--disable-settings-management"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Check Magento Composer public key", "arguments": ["composer", "--quiet", "config", "--global", "--auth", "http-basic.repo.magento.com.username"], "failureHelp": "Configure Adobe Marketplace credentials in DDEV's global homeadditions/.composer/auth.json, then retry."},
      {"title": "Check Magento Composer private key", "arguments": ["composer", "--quiet", "config", "--global", "--auth", "http-basic.repo.magento.com.password"], "failureHelp": "Configure both Adobe Marketplace keys in DDEV's global homeadditions/.composer/auth.json, then retry."},
      {"title": "Install OpenSearch", "arguments": ["add-on", "get", "ddev/ddev-opensearch"]},
      {"title": "Restart DDEV with OpenSearch", "arguments": ["restart", "--skip-confirmation"]},
      {"title": "Install Magento", "arguments": ["composer", "create-project", "--repository", "https://repo.magento.com/", "magento/project-community-edition"]},
      {"title": "Reset Magento environment", "arguments": ["exec", "rm", "-f", "app/etc/env.php"]},
      {"title": "Configure Magento", "arguments": ["bin/magento", "setup:install", "--base-url=${PRIMARY_URL}/", "--cleanup-database", "--db-host=db", "--db-name=db", "--db-user=db", "--db-password=db", "--opensearch-host=opensearch", "--search-engine=opensearch", "--opensearch-port=9200", "--admin-firstname=Magento", "--admin-lastname=User", "--admin-email=${EMAIL}", "--admin-user=${USERNAME}", "--admin-password=${PASSWORD}", "--language=en_US"], "sensitive": true},
      {"title": "Enable Magento developer mode", "arguments": ["magento", "deploy:mode:set", "developer"]},
      {"title": "Disable Magento two-factor modules", "arguments": ["magento", "module:disable", "Magento_TwoFactorAuth", "Magento_AdminAdobeImsTwoFactorAuth"]},
      {"title": "Enable Magento settings management", "arguments": ["config", "--disable-settings-management=false"]},
      {"title": "Configure Magento admin path", "arguments": ["magento", "setup:config:set", "--backend-frontname=admin_ddev", "--no-interaction"]}
    ],
    "requiresCredentials": true,
    "launch": {"path": "/admin_ddev"}
  },
  {
    "id": "moodle",
    "displayName": "Moodle",
    "projectType": "php",
    "configArguments": ["--project-type=php", "--composer-root=public", "--docroot=public", "--webserver-type=apache-fpm", "--database=mariadb:10.11"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Moodle", "arguments": ["composer", "create-project", "moodle/moodle"]},
      {"title": "Configure Moodle", "arguments": ["php", "public/admin/cli/install.php", "--non-interactive", "--agree-license", "--wwwroot=${PRIMARY_URL}", "--dbtype=mariadb", "--dbhost=db", "--dbname=db", "--dbuser=db", "--dbpass=db", "--fullname=${PROJECT_NAME}", "--shortname=${PROJECT_NAME}", "--adminuser=${USERNAME}", "--adminpass=${PASSWORD}", "--adminemail=${EMAIL}"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "launch": {"path": "/login"}
  },
  {
    "id": "shopware6",
    "displayName": "Shopware 6",
    "projectType": "shopware6",
    "configArguments": ["--project-type=shopware6", "--docroot=public"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Shopware", "arguments": ["composer", "create-project", "shopware/production"]},
      {"title": "Configure Shopware", "arguments": ["exec", "console", "system:install", "--basic-setup"]}
    ],
    "requiresCredentials": false,
    "automaticProjectType": true,
    "launch": {"path": "/admin"}
  },
  {
    "id": "silverstripe",
    "displayName": "Silverstripe CMS",
    "projectType": "silverstripe",
    "configArguments": ["--project-type=silverstripe", "--database=mariadb:10.11", "--docroot=public"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Silverstripe", "arguments": ["composer", "create-project", "--prefer-dist", "silverstripe/installer"]},
      {"title": "Configure Silverstripe database", "writeFiles": [{"path": ".env.development", "resource": "/cms/templates/silverstripe.env"}]},
      {"title": "Restart DDEV", "arguments": ["restart", "--skip-confirmation"]},
      {"title": "Build Silverstripe database", "arguments": ["sake", "dev/build", "flush=all"]}
    ],
    "requiresCredentials": false,
    "automaticProjectType": true
  },
  {
    "id": "statamic",
    "displayName": "Statamic",
    "projectType": "laravel",
    "configArguments": ["--project-type=laravel", "--docroot=public"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Statamic", "arguments": ["composer", "create-project", "--prefer-dist", "statamic/statamic"]},
      {"title": "Create Statamic administrator", "arguments": ["php", "please", "make:user", "${EMAIL}", "--password=${PASSWORD}", "--super", "--no-interaction"], "sensitive": true}
    ],
    "requiresCredentials": true
  },
  {
    "id": "symfony",
    "displayName": "Symfony",
    "projectType": "symfony",
    "configArguments": ["--project-type=symfony", "--docroot=public"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install Symfony", "arguments": ["composer", "create-project", "symfony/skeleton"]},
      {"title": "Install Symfony web application packages", "arguments": ["composer", "require", "webapp"]}
    ],
    "requiresCredentials": false,
    "automaticProjectType": true
  },
  {
    "id": "typo3",
    "displayName": "TYPO3",
    "projectType": "typo3",
    "configArguments": ["--project-type=typo3", "--docroot=public"],
    "steps": [
      {"title": "Start DDEV", "arguments": ["start", "--skip-confirmation"]},
      {"title": "Install TYPO3", "arguments": ["composer", "create-project", "typo3/cms-base-distribution:^14"]},
      {"title": "Configure TYPO3", "arguments": ["vendor/bin/typo3", "setup", "--admin-user-password=${PASSWORD}", "--driver=mysqli", "--create-site=${PRIMARY_URL}", "--server-type=other", "--dbname=db", "--username=db", "--password=db", "--port=3306", "--host=db", "--admin-username=${USERNAME}", "--admin-email=${EMAIL}", "--project-name=${PROJECT_NAME}", "--force"], "sensitive": true}
    ],
    "requiresCredentials": true,
    "automaticProjectType": true
  }
  ]
}
