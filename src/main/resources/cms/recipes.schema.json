{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://php-perfect.de/ddev-intellij-plugin/cms/recipes.schema.json",
  "title": "DDEV CMS installation recipe catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipes"],
  "properties": {
    "$schema": {"type": "string"},
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/recipe"}
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "projectType", "configArguments", "steps", "requiresCredentials"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*$"},
        "displayName": {"type": "string", "minLength": 1},
        "projectType": {"type": "string", "minLength": 1},
        "configArguments": {"$ref": "#/$defs/arguments"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "requiresCredentials": {"type": "boolean"},
        "automaticProjectType": {"type": "boolean", "default": false},
        "launch": {"$ref": "#/$defs/launch"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "arguments": {"$ref": "#/$defs/arguments"},
        "writeFiles": {
          "type": "array",
          "items": {"$ref": "#/$defs/writeFile"}
        },
        "moveContents": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "anyOf": [
        {"required": ["arguments"]},
        {"required": ["writeFiles"]},
        {"required": ["moveContents"]}
      ]
    },
    "arguments": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "writeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "resource"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "pattern": "^/cms/templates/"}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "query": {"type": "string", "minLength": 1}
      },
      "minProperties": 1
    }
  }
}
