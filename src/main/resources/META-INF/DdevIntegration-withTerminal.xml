<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="de.php_perfect.intellij.ddev.terminal.DdevTerminalServiceImpl"
                        serviceInterface="de.php_perfect.intellij.ddev.terminal.DdevTerminalService"/>
        <terminal.shellCommandHandler implementation="de.php_perfect.intellij.ddev.cmd.DdevShellCommandHandlerImpl"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <openPredefinedTerminalProvider
                implementation="de.php_perfect.intellij.ddev.terminal.DdevPredefinedTerminalActionProvider"/>
    </extensions>

    <projectListeners>
        <listener class="de.php_perfect.intellij.ddev.terminal.TutorialListener"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
    </projectListeners>

    <actions resource-bundle="messages.DdevIntegrationBundle">
        <action id="DdevIntegration.Terminal" class="de.php_perfect.intellij.ddev.actions.DdevPredefinedTerminalAction"
                icon="de.php_perfect.intellij.ddev.icons.DdevIntegrationIcons.DdevLogoColor"/>
        <action id="DdevIntegration.DatabaseTerminal"
                class="de.php_perfect.intellij.ddev.actions.DdevDatabaseTerminalAction"
                icon="de.php_perfect.intellij.ddev.icons.DdevIntegrationIcons.DdevLogoColor"/>
        <action id="DdevIntegration.ServiceTerminal"
                class="de.php_perfect.intellij.ddev.actions.DdevServiceTerminalAction"
                icon="de.php_perfect.intellij.ddev.icons.DdevIntegrationIcons.DdevLogoColor"/>
    </actions>
</idea-plugin>
